{
  "name": "robloxui",
  "version": "0.2.11",
  "description": "RobloxUI CLI — add Roblox UI components to your project with auto-detection",
  "license": "MIT",
  "author": "RobloxUI",
  "homepage": "https://robloxui.pencipta.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erickow/robloxui-cli.git"
  },
  "bugs": {
    "url": "https://github.com/erickow/robloxui-cli/issues"
  },
  "keywords": [
    "roblox",
    "roblox-ts",
    "luau",
    "react-luau",
    "ui-components",
    "cli",
    "rojo",
    "wally",
    "marketplace"
  ],
  "bin": {
    "robloxui": "dist/index.js"
  },
  "exports": {
    "./theme": {
      "types": "./theme/src/index.ts",
      "default": "./theme/src/index.ts"
    },
    "./theme/luau": "./theme/src/theme.lua",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "assets",
    "theme",
    "README.md"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "tsx src/__tests__/smoke/rojo-smoke.ts",
    "prepublishOnly": "npm run build && npm run test"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
